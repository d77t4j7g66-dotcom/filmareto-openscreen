<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Filmareto OpenScreen</title>
  <welcome file="welcome.txt" mime-type="text/plain"/>
  <conclusion file="conclusion.txt" mime-type="text/plain"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
  <choices-outline><line choice="default"><line choice="app"/></line></choices-outline>
  <choice id="default"/>
  <choice id="app" visible="false"><pkg-ref id="com.filmareto.openscreen.pkg"/></choice>
  <pkg-ref id="com.filmareto.openscreen.pkg" version="VERSION" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
